# Vercel 프로젝트 설정 > Environment Variables 에 같은 이름으로 넣는다.
# 로컬은 `vercel env pull` 로 .env.local 을 받아오거나 직접 적는다.

# 필수. 서버(api/)에서만 쓰고 브라우저에는 절대 내려가지 않는다.
ANTHROPIC_API_KEY=sk-ant-...

# 선택. 비우면 claude-opus-5. 비용을 낮추려면 claude-sonnet-5.
# CLAUDE_MODEL=claude-opus-5

# 선택. 추출 정확도/속도 조절. low | medium | high (기본 medium)
# CLAUDE_EFFORT=medium

# 선택. 넣으면 사진 추출 API를 호출할 때 이 비밀번호를 요구한다.
# 배포 URL이 새어 나가도 남이 내 API 키로 추출을 돌리지 못하게 막는 용도.
# 비워두면 아무나 호출할 수 있다 (가족만 URL을 아는 전제).
# APP_PASSCODE=
